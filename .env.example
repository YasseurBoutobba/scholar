# ===== Postgres (local, via docker-compose) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scholar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scholar

# ===== Redis (local, via docker-compose) =====
REDIS_URL=redis://localhost:6379/0

# ===== Qdrant Cloud =====
# Create a free cluster at https://cloud.qdrant.io and paste its URL + API key here.
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=
COLLECTION_NAME=documents
DENSE_VECTOR_SIZE=384

# ===== LLM provider =====
# OpenRouter is used when OPENROUTER_API_KEY is set. Otherwise Scholar falls back
# to Gemini automatically (Gemini is the default provider out of the box).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_STRONG_MODEL=anthropic/claude-sonnet-4

# Gemini (default fallback LLM provider) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_STRONG_MODEL=gemini-3.1-pro

# ===== Cohere (Reranker) =====
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
RERANK_ENABLED=true

# ===== Embeddings =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ===== App =====
APP_NAME=Scholar API
ENV=development
LOG_LEVEL=INFO

# ===== Evaluation =====
FAITHFULNESS_THRESHOLD=0.7
RETRY_MAX_ATTEMPTS=3

# ===== Uploads =====
MAX_UPLOAD_MB=50
